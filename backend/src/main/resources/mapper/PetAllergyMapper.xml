<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hnist.mapper.PetAllergyMapper">
    <resultMap id="allergyMap" type="com.hnist.entity.PetAllergy">
        <id property="id" column="id"/>
        <result property="petId" column="pet_id"/>
        <result property="allergenCode" column="allergen_code"/>
        <result property="severity" column="severity"/>
        <result property="note" column="note"/>
    </resultMap>

    <select id="selectByPetId" resultMap="allergyMap">
        SELECT id, pet_id, allergen_code, severity, note
        FROM pet_allergies
        WHERE pet_id = #{petId}
        ORDER BY allergen_code
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT IGNORE INTO pet_allergies (pet_id, allergen_code, severity, note)
        VALUES (#{petId}, #{allergenCode}, #{severity}, #{note})
    </insert>

    <delete id="deleteByPetIds">
        DELETE FROM pet_allergies
        WHERE pet_id IN
        <foreach collection="petIds" item="petId" open="(" separator="," close=")">
            #{petId}
        </foreach>
    </delete>
</mapper>
